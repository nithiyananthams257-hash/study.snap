# Copy this file to .streamlit/secrets.toml (drop ".example") and fill in real values.
# NEVER commit the real secrets.toml to GitHub.

# From Google AI Studio (aistudio.google.com > Get API key)
GEMINI_API_KEY = "your-gemini-api-key-here"

# Make your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY = "your-long-random-text-here"

# Login users: username = "password hash"
# Hash a password: python -c "import hashlib; print(hashlib.sha256(b'your-password').hexdigest())"
[users]
student1 = "replace-with-password-hash"
